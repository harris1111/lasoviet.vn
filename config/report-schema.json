{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LasovietReportOutline",
  "type": "object",
  "required": ["report_id", "chart_id", "sku", "provenance", "claims", "sections", "limitations"],
  "properties": {
    "report_id": {"type": "string"},
    "chart_id": {"type": "string"},
    "sku": {"type": "string"},
    "provenance": {
      "type": "object",
      "required": ["method", "engine_version", "rule_set", "chart_schema_version", "evidence_version", "prompt_version", "model_id"],
      "properties": {
        "method": {"type": "string"},
        "engine_version": {"type": "string"},
        "rule_set": {"type": "string"},
        "chart_schema_version": {"type": "string"},
        "evidence_version": {"type": "string"},
        "prompt_version": {"type": "string"},
        "model_id": {"type": "string"}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "evidence_keys", "confidence"],
        "properties": {
          "claim_id": {"type": "string"},
          "text": {"type": "string"},
          "evidence_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "confidence": {"enum": ["low", "medium", "high"]},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "sections": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
