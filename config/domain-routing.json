{
  "canonical": "https://lasoviet.net",
  "domains": {
    "lasoviet.net": {"role": "brand_seo_app_commerce", "index": true, "checkout": true},
    "lasoviet.vn": {"role": "brand_redirect_reserve", "index": false, "checkout": false, "root_action": "301_to_lasoviet.net"},
    "lasoviet.cloud": {"role": "infrastructure_reserve", "index": false, "checkout": false, "root_action": "301_to_lasoviet.net"},
    "lasoviet.xyz": {"role": "defensive_or_lab", "index": false, "checkout": false, "root_action": "301_to_lasoviet.net"}
  },
  "dns": {
    "registrar": "Mat Bao",
    "provider": "Cloudflare",
    "nameservers": ["clayton.ns.cloudflare.com", "stephane.ns.cloudflare.com"]
  },
  "rules": [
    "Only lasoviet.net may host indexable public content.",
    "Private reports, accounts and checkout must be noindex.",
