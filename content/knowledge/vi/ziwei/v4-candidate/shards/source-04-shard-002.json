    {
      "passageId": "ziwei-v4-6cf4232a126f82de5facc441",
      "reportSections": [
        "cycles_and_timing",
        "data_and_method"
      ],
      "content": "Lớp thời gian tạo bối cảnh cho diễn giải, còn một thay đổi lớn cần nhiều nhóm thông tin cùng hướng về một chủ đề. Kết quả nên được đối chiếu với trải nghiệm trước đó và phải lưu cả điểm không phù hợp. Lịch sử nhận định cần được giữ nguyên để việc điều chỉnh sau này có thể truy vết.",
      "contentHash": "dc4a8e3a3fdca1237a11f6548ce9115bdfe4f260d4393265fcbbe27f2969d8ab",
      "metadata": {
        "topics": [
          "methodology",
          "timing"
        ],
        "palaces": [],
        "stars": [],
        "brightness": [
          "ziwei.brightness.weak"
        ],
        "transformations": [],
        "relations": [],
        "patterns": [],
