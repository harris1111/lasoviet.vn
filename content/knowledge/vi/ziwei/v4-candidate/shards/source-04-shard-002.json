    {
      "passageId": "ziwei-v4-6c6f09cd58f3ca05b92b39d0",
      "reportSections": [
        "data_and_method"
      ],
      "content": "Khi chính cung và các cung liên hệ tạo tín hiệu khác nhau, cần mô tả cả năng lực nền lẫn điều kiện hỗ trợ hoặc hạn chế. Một giai đoạn khó không xóa toàn bộ khả năng sẵn có, và một giai đoạn thuận không xóa các thói quen cần điều chỉnh. Kết luận nên gắn với bối cảnh thay vì dùng một nhãn tổng quát.",
      "contentHash": "32b1657b4fd9fadce2f84d52860e2386f24f454fe005b4705710beb98761daf7",
      "metadata": {
        "topics": [
          "methodology"
        ],
        "palaces": [],
        "stars": [],
        "brightness": [
          "ziwei.brightness.weak"
        ],
        "transformations": [],
        "relations": [],
        "patterns": [],
        "sourceType": "modern",
        "languageOrigin": "vi",
        "priority": 2
      },
      "sourcePassageIds": [
        "ziwei-v3-04-c0f53795-00023-f7d790244025",
        "ziwei-v3-04-c0f53795-00024-09c49a807173",
