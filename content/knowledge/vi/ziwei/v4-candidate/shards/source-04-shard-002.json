    },
    {
      "passageId": "ziwei-v4-9bf0c9c23927ea72ac3f71d5",
      "reportSections": [
        "data_and_method"
      ],
      "content": "Một khuynh hướng chỉ nên được nâng thành khả năng sự kiện khi có dấu hiệu nền, cung chức năng xác nhận, lớp thời gian liên quan và không có phản chứng đủ mạnh. Với thay đổi lớn trong gia đình, nơi ở, hướng nghề hay nguồn lực, cần nhiều nhóm dấu hiệu độc lập. Quy tắc này giữ cho suy luận không vượt quá bằng chứng hiện có.",
      "contentHash": "af6193a8592c59e2def007540e27b1c38966de885b86510c8f1c33301cfc71e4",
      "metadata": {
        "topics": [
          "methodology"
        ],
        "palaces": [],
        "stars": [],
        "brightness": [],
        "transformations": [],
        "relations": [],
        "patterns": [],
