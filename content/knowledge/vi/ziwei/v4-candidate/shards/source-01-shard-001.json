  "records": [
    {
      "reportSections": [
        "primary_evidence"
      ],
      "content": "Tử Vi được trình bày như một điểm quy chiếu để đọc cấu trúc chung của lá số và vị trí tương quan giữa các sao. Ý nghĩa này nghiêng về vai trò điều phối, ý thức trách nhiệm và cách sắp xếp thứ tự ưu tiên. Khi xét Tử Vi, cần nhìn toàn bộ tổ hợp thay vì biến một tên sao thành kết luận về con người.",
      "contentHash": "71c007af687d2914eadd4c5c4a00b67ee3706bcf9a333b777cd92a36930f91d7",
