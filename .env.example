# Copy this template to an external file outside the repository before use.
DEPLOY_ENV_FILE=.env.example
NODE_ENV=production
WEB_HOST_PORT=49152

POSTGRES_DB=lasoviet
POSTGRES_USER=lasoviet
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://lasoviet:replace-with-a-strong-password@postgres:5432/lasoviet
REDIS_URL=redis://redis:6379

INTERNAL_ACTOR_SECRET=replace-with-a-strong-secret
BETTER_AUTH_SECRET=replace-with-a-strong-secret
# Local founder-run value. On a VPS, override this in the external deploy env
# with the canonical public HTTPS origin: https://lasoviet.net.
BETTER_AUTH_URL=http://127.0.0.1:49152
PRIVATE_API_URL=http://api:3001

# SePay Payment Gateway; set to disabled for automatic payments in development/preview.
# For active sandbox/production payments, supply real provider credentials in the
# external file selected by DEPLOY_ENV_FILE.
SEPAY_ENV=disabled
# SEPAY_MERCHANT_ID=
# SEPAY_SECRET_KEY=
# SEPAY_BANK_CODE=
# SEPAY_ACCOUNT_NUMBER=
# SEPAY_ACCOUNT_HOLDER=
# SEPAY_ORDER_TTL_SECONDS=86400
# SEPAY_WEBHOOK_SECRET=

# Optional AI report generation provider (all variables below required when configuring AI).
# AI_PRODUCTION_ENABLED=false is the fail-closed default; production report generation
# requires changing it to true only after provider capability approval.
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=replace-with-provider-api-key
# AI_MODEL=replace-with-approved-model
# AI_TIMEOUT=15000
# AI_MAX_RETRIES=2
# AI_FEATURE_JSON_SCHEMA=true
# AI_FEATURE_TOOL_CALLING=false
# AI_PRODUCTION_ENABLED=false
