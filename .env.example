# Copy this template to an external file outside the repository before use.
DEPLOY_ENV_FILE=.env.example
NODE_ENV=production
WEB_HOST_PORT=49152

POSTGRES_DB=lasoviet
POSTGRES_USER=lasoviet
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://lasoviet:replace-with-a-strong-password@postgres:5432/lasoviet
REDIS_URL=redis://redis:6379

INTERNAL_ACTOR_SECRET=replace-with-a-strong-secret
BETTER_AUTH_SECRET=replace-with-a-strong-secret
# Local founder-run value. On a VPS, override this in the external deploy env
# with the canonical public HTTPS origin: https://lasoviet.vn.
BETTER_AUTH_URL=http://127.0.0.1:49152
PRIVATE_API_URL=http://api:3001

# SePay Payment Gateway; use placeholders only and keep real values in the
# external file selected by DEPLOY_ENV_FILE.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=replace-with-sandbox-merchant-id
SEPAY_SECRET_KEY=replace-with-sandbox-secret-key
